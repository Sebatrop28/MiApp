rules_version = '2';

// Reglas de MiApp. Cópialas en Firebase → Firestore Database → Reglas → Publicar.
// Solo hay perfiles, solicitudes, amistades, la señalización WebRTC (calls, se borra al conectar)
// el buzón `relay` (mensajes cifrados de extremo a extremo que el destinatario borra al recibirlos)
// y las publicaciones (`posts`, `postImages`), visibles para todas las cuentas.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function me() {
      return request.auth.uid;
    }

    function path(collectionName, id) {
      return /databases/$(database)/documents/$(collectionName)/$(id);
    }

    function storedProfile(uid) {
      let p = get(path('profiles', uid)).data;
      return { 'uid': p.uid, 'username': p.username, 'displayName': p.displayName };
    }

    match /profiles/{uid} {
      allow read: if signedIn();
      // El nombre de usuario debe quedar reservado a esta cuenta en la misma transacción.
      allow create: if signedIn() && uid == me()
        && request.resource.data.keys().hasOnly(['uid', 'username', 'displayName', 'createdAt'])
        && request.resource.data.uid == uid
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 60
        && request.resource.data.createdAt is int
        && getAfter(path('usernames', request.resource.data.username)).data.uid == uid;
      // Solo se puede cambiar la llave pública del chat (X25519, 32 bytes en base64).
      allow update: if signedIn() && uid == me()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['publicKey'])
        && request.resource.data.publicKey is string
        && request.resource.data.publicKey.matches('^[A-Za-z0-9+/]{43}=$');
      allow delete: if false;
    }

    match /usernames/{name} {
      allow read: if signedIn();
      allow create: if signedIn()
        && name.matches('^[a-zñ0-9_.]{3,20}$')
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == me()
        && !exists(path('profiles', me()))
        && getAfter(path('profiles', me())).data.username == name;
      allow update, delete: if false;
    }

    match /friendRequests/{id} {
      allow read: if signedIn() && (resource.data.from == me() || resource.data.to == me());
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['from', 'to', 'fromProfile', 'toProfile', 'createdAt'])
        && request.resource.data.from == me()
        && request.resource.data.to != me()
        && id == me() + '_' + request.resource.data.to
        && request.resource.data.createdAt is int
        && request.resource.data.fromProfile == storedProfile(me())
        && request.resource.data.toProfile == storedProfile(request.resource.data.to)
        && !exists(path('friendships', me() < request.resource.data.to
          ? me() + '_' + request.resource.data.to
          : request.resource.data.to + '_' + me()));
      allow update: if false;
      allow delete: if signedIn() && (resource.data.from == me() || resource.data.to == me());
    }

    match /friendships/{id} {
      allow read: if signedIn() && me() in resource.data.members;
      // Solo quien recibió la solicitud puede aceptarla.
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['members', 'profiles', 'createdAt'])
        && request.resource.data.members is list
        && request.resource.data.members.size() == 2
        && me() in request.resource.data.members
        && request.resource.data.members[0] < request.resource.data.members[1]
        && id == request.resource.data.members[0] + '_' + request.resource.data.members[1]
        && request.resource.data.createdAt is int
        // La solicitud debe existir y borrarse en la misma escritura (no se puede reutilizar).
        && exists(path('friendRequests', otherMember(request.resource.data.members) + '_' + me()))
        && !existsAfter(path('friendRequests', otherMember(request.resource.data.members) + '_' + me()))
        && request.resource.data.profiles.keys().hasOnly(request.resource.data.members)
        && request.resource.data.profiles[me()] == storedProfile(me())
        && request.resource.data.profiles[otherMember(request.resource.data.members)]
          == storedProfile(otherMember(request.resource.data.members));
      allow update: if false;
      allow delete: if signedIn() && me() in resource.data.members;
    }

    function areFriends(a, b) {
      return exists(path('friendships', a < b ? a + '_' + b : b + '_' + a));
    }

    function isDescription(value, kind) {
      return value is map
        && value.keys().hasOnly(['type', 'sdp'])
        && value.type == kind
        && value.sdp is string
        && value.sdp.size() < 20000;
    }

    // Oferta/respuesta WebRTC entre dos amigos: no contiene mensajes y se borra al conectar.
    match /calls/{id} {
      allow read: if signedIn() && (resource.data.from == me() || resource.data.to == me());
      // Quien llama puede crear la oferta o reemplazarla por una nueva.
      allow create, update: if signedIn()
        && request.resource.data.keys().hasOnly(['from', 'to', 'offer', 'createdAt'])
        && request.resource.data.from == me()
        && request.resource.data.to is string
        && id == me() + '_' + request.resource.data.to
        && isDescription(request.resource.data.offer, 'offer')
        && request.resource.data.createdAt is int
        && areFriends(me(), request.resource.data.to);
      // Quien recibe solo puede añadir la respuesta.
      allow update: if signedIn()
        && resource.data.to == me()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['answer'])
        && isDescription(request.resource.data.answer, 'answer')
        && areFriends(me(), resource.data.from);
      allow delete: if signedIn() && (resource.data.from == me() || resource.data.to == me());
    }

    // Mensajes cifrados para un amigo sin conexión directa. El servidor no puede leerlos.
    match /relay/{id} {
      allow read: if signedIn() && (resource.data.from == me() || resource.data.to == me());
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['from', 'to', 'msgId', 'part', 'parts', 'nonce', 'data', 'createdAt'])
        && request.resource.data.from == me()
        && request.resource.data.to is string
        && request.resource.data.msgId is string
        && request.resource.data.msgId.matches('^[a-z0-9-]{1,40}$')
        && request.resource.data.parts is int
        && request.resource.data.parts >= 1 && request.resource.data.parts <= 8
        && request.resource.data.part is int
        && request.resource.data.part >= 0 && request.resource.data.part < request.resource.data.parts
        && id == me() + '_' + request.resource.data.to + '_' + request.resource.data.msgId + '_' + string(request.resource.data.part)
        && request.resource.data.nonce is string
        && request.resource.data.nonce.size() == 32
        && request.resource.data.data is string
        && request.resource.data.data.size() <= 900000
        && request.resource.data.createdAt is int
        && areFriends(me(), request.resource.data.to);
      allow update: if false;
      allow delete: if signedIn() && (resource.data.from == me() || resource.data.to == me());
    }

    // Publicaciones visibles para todas las cuentas con sesión iniciada.
    function likeChange(before, after) {
      let unique = after.size() == after.toSet().size();
      let added = after.toSet().difference(before.toSet());
      let removed = before.toSet().difference(after.toSet());
      return unique && ((added == [me()].toSet() && removed.size() == 0)
        || (removed == [me()].toSet() && added.size() == 0));
    }

    match /posts/{id} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['authorUid', 'author', 'text', 'link', 'image', 'likes', 'createdAt'])
        && request.resource.data.authorUid == me()
        && request.resource.data.author == storedProfile(me())
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 1000
        && (request.resource.data.link == null
          || (request.resource.data.link is string
            && request.resource.data.link.size() <= 500
            && request.resource.data.link.matches('^[Hh][Tt][Tt][Pp][Ss]?://[^ /?#]+[^ ]*$')))
        && (request.resource.data.image == null
          || (request.resource.data.image is map
            && request.resource.data.image.keys().hasOnly(['width', 'height'])
            && request.resource.data.image.width is number
            && request.resource.data.image.height is number
            && !exists(path('postImages', id))
            && existsAfter(path('postImages', id))))
        && (request.resource.data.text.size() > 0 || request.resource.data.link != null || request.resource.data.image != null)
        && request.resource.data.likes == []
        // La fecha debe ser la actual (±5 min por la hora del teléfono): no se puede fijar en el futuro.
        && request.resource.data.createdAt is int
        && request.resource.data.createdAt > request.time.toMillis() - 300000
        && request.resource.data.createdAt < request.time.toMillis() + 300000;
      // Cualquiera puede dar o quitar solo su propio «me gusta».
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes'])
        && request.resource.data.likes is list
        && likeChange(resource.data.likes, request.resource.data.likes);
      allow delete: if signedIn() && resource.data.authorUid == me();
    }

    match /postImages/{id} {
      allow read: if signedIn();
      allow create: if signedIn()
        && getAfter(path('posts', id)).data.authorUid == me()
        && request.resource.data.keys().hasOnly(['data'])
        && request.resource.data.data is string
        && request.resource.data.data.size() <= 900000;
      allow update: if false;
      allow delete: if signedIn() && get(path('posts', id)).data.authorUid == me();
    }

    function otherMember(members) {
      return members[0] == me() ? members[1] : members[0];
    }
  }
}
