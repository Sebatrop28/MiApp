{
  "expo": {
    "name": "MiApp",
    "slug": "miapp",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "miapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.sebatrop28.miapp"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#4F46E5",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.sebatrop28.miapp",
      "versionCode": 1,
      "permissions": [
        "android.permission.ACCESS_NETWORK_STATE"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#4F46E5",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76,
          "dark": {
            "backgroundColor": "#0B1020",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "MiApp usa tus fotos para enviarlas a tus amigos por el chat.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "extraProguardRules": "-dontwarn org.webrtc.**\n-keep class org.webrtc.** { *; }"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "description": "MiApp: base profesional de aplicación Android con Expo Router y TypeScript.",
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "56dd7e97-df8d-4fcf-a536-e5d66f0e5285"
      },
      "firebase": {
        "apiKey": "AIzaSyBDCl-4XDBZcj7aLXW5GozIFue_hBBTpFE",
        "authDomain": "app-de-particion.firebaseapp.com",
        "projectId": "app-de-particion",
        "storageBucket": "app-de-particion.firebasestorage.app",
        "messagingSenderId": "1085418371941",
        "appId": "1:1085418371941:web:24b8673c397b29d3cbbf8c"
      },
      "googleWebClientId": "1085418371941-tpfoo28991rf3bovvv04ukel7t4860lg.apps.googleusercontent.com"
    },
    "owner": "sebatrop",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/56dd7e97-df8d-4fcf-a536-e5d66f0e5285",
      "checkAutomatically": "NEVER"
    }
  }
}
